# ---------------------------------------------------------------------------
# Django Environment Configuration (.env)
# Do NOT commit your real .env to git!
# ---------------------------------------------------------------------------

# Django Secret Key (generate a random 50+ character string for production)
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key

# Debug Mode (True for local development, False for production)
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated list of hosts/domains)
# On Render, RENDER_EXTERNAL_HOSTNAME and .onrender.com are automatically included
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database URL
# Leave unset or empty for local SQLite (backend/db.sqlite3)
# On Render, set by attached PostgreSQL service (e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=

# CORS Allowed Origins (comma-separated list of allowed frontend origins)
# Vercel deployments (*.vercel.app) and localhost ports are automatically supported
# Set this if using a custom production domain (e.g. https://my-student-portal.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
